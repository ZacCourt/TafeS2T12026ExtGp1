<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Calculator.UnitsConverter"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Calculator"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="0.5*"/>
			<ColumnDefinition/>
			<ColumnDefinition Width="0.5*"/>
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition Height="0.5*"/>
			<RowDefinition/>
			<RowDefinition Height="0.25*"/>
			<RowDefinition Height="0.5*"/>
		</Grid.RowDefinitions>
		<Viewbox VerticalAlignment="Top">
			<Button
				Margin="0,0,10,0"
				x:Name="returnToMenuButton"
				Click="returnToMenuButton_Click">Return To Menu</Button>
		</Viewbox>
		<Viewbox VerticalAlignment="Top" Grid.Column="1">
			<TextBlock>Units Converter</TextBlock>
		</Viewbox>
		<Viewbox Grid.Column="1" Grid.Row="1">
			<StackPanel Margin="0,10,0,10" Width="400" Spacing="10" VerticalAlignment="Center">
				<TextBox
					x:Name="inputOneTextBox"
					FontSize="50"
					PlaceholderText="Input"
					TextAlignment="Center"
					TextChanged="inputTextBox_TextChanged"/>
				<TextBox
					x:Name="outputTextBox"
					FontSize="50"
					PlaceholderText="Output"
					TextAlignment="Center"
					IsReadOnly="True"/>
			</StackPanel>
		</Viewbox>
		<ComboBox
			Grid.Column="1"
			Grid.Row="2"
			Margin="10"
			x:Name="conversionTypeComboBox"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			HorizontalContentAlignment="Center"
			SelectionChanged="conversionTypeComboBox_SelectionChanged">
			<ComboBoxItem IsSelected="True" Content="Celsius -> Fahrenheit"/>
			<ComboBoxItem Content="Fahrenheit -> Celsius"/>
			<ComboBoxItem Content="Kilos -> Pounds"/>
			<ComboBoxItem Content="Pounds -> Kilos"/>
			<ComboBoxItem Content="Meters -> Feet"/>
			<ComboBoxItem Content="Feet -> Meters"/>
		</ComboBox>
	</Grid>
</Page>
